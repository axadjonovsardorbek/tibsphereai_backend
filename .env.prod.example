# Prod stack: copy to .env.prod on the server (gitignored) and fill secrets.
# Run: docker compose -p tibsphereai-prod --env-file .env.prod up -d --build
ENV_FILE=.env.prod

# host ports (bound to 127.0.0.1, proxied by Caddy)
HOST_APP_PORT=8005
HOST_POSTGRES_PORT=5474
HOST_REDIS_PORT=6338
HOST_MINIO_PORT=9020
HOST_MINIO_CONSOLE_PORT=9021

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_NAME=tibsphereai_prod

BASE_URL=https://prod.tibstation.uz
WEBSITE_URL=https://tibstation.uz
MINIO_DOMAIN=https://minio.tibstation.uz
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET_NAME=tibsphereai-bucket

FIREBASE_CREDENTIALS=./internal/secrets/firebase-admin.json
JWT_SECRET=change-me
# + BOT_TOKEN, NEW_BOT_TOKEN, GROUP_ID, CLICK_*, PAYME_*, BREVO_*, GEMINI_*, GOOGLE_CLIENT_ID, ... (see .env.example)
