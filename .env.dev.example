# Dev stack: copy to .env.dev on the server (gitignored) and fill secrets.
# Run: docker compose -p tibsphereai-dev --env-file .env.dev up -d --build
ENV_FILE=.env.dev

# host ports (bound to 127.0.0.1, proxied by Caddy)
HOST_APP_PORT=8004
HOST_POSTGRES_PORT=5473
HOST_REDIS_PORT=6337
HOST_MINIO_PORT=9010
HOST_MINIO_CONSOLE_PORT=9011

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_NAME=tibsphereai_dev

BASE_URL=https://dev.tibstation.uz
WEBSITE_URL=https://tibstation.uz
MINIO_DOMAIN=https://dev-minio.tibstation.uz
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me-too
MINIO_BUCKET_NAME=tibsphereai-bucket

FIREBASE_CREDENTIALS=./internal/secrets/firebase-admin.json
JWT_SECRET=change-me
# + BOT_TOKEN, NEW_BOT_TOKEN, GROUP_ID, CLICK_*, PAYME_*, BREVO_*, GEMINI_*, GOOGLE_CLIENT_ID, ... (see .env.example)
